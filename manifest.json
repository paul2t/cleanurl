{
  "manifest_version": 3,
  "name": "CleanURL",
  "version": "1.0.15",
  "description": "Removes 900+ tracking parameters from links before they load and from links you copy. Nothing is collected, nothing is sent.",
  "minimum_chrome_version": "116",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "storage",
    "contextMenus",
    "scripting",
    "webRequest"
  ],
  "optional_permissions": ["clipboardRead"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "CleanURL",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/rules.js",
        "src/cleaner.js",
        "src/copy-guard.js",
        "src/field-guard.js",
        "src/link-guard.js",
        "src/settings.js",
        "src/content-isolated.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/page-world.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
